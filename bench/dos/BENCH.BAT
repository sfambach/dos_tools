@ECHO OFF
REM BENCH - run all benchmarks once per setup and hand the results to the server.
REM   BENCH        continue where the last run stopped (after a crash or reboot)
REM   BENCH NEU    start all tests again
REM A changed BIOS setup, CONFIG.SYS, AUTOEXEC.BAT or HOST.BAT starts a new run as well.
IF NOT EXIST C:\BENCH\HOST.BAT GOTO NOCFG
CALL C:\BENCH\HOST.BAT
SET S=C:\BENCH\STATE
SET R=C:\BENCH\RAW
IF NOT EXIST %S%\NUL MD %S%
IF NOT EXIST %R%\NUL MD %R%
IF "%1"=="NEU" GOTO RESET
IF "%1"=="neu" GOTO RESET
C:\BENCH\CHKCFG %S%\CFG.FP C:\CONFIG.SYS C:\AUTOEXEC.BAT C:\BENCH\HOST.BAT
IF ERRORLEVEL 2 GOTO END
IF ERRORLEVEL 1 GOTO RESET
GOTO RUN

:RESET
ECHO BENCH: new run
IF EXIST %S%\*.OK DEL %S%\*.OK
IF EXIST %S%\*.RUN DEL %S%\*.RUN
IF EXIST %S%\*.ERR DEL %S%\*.ERR
IF EXIST %R%\*.* DEL %R%\*.*
C:\BENCH\CHKCFG %S%\CFG.FP C:\CONFIG.SYS C:\AUTOEXEC.BAT C:\BENCH\HOST.BAT > NUL
ECHO SETUP=%SETUP%> %R%\RUN.INI
ECHO HOST=%HOST%>> %R%\RUN.INI
COPY %S%\CFG.FP %R%\CFG.FP > NUL

:RUN
REM Order: text-mode tools first, then the long graphics tests.
CALL C:\BENCH\RUNTEST CHKCPU
CALL C:\BENCH\RUNTEST CACHECHK
CALL C:\BENCH\RUNTEST TOPBENCH
CALL C:\BENCH\RUNTEST SPEEDSYS
CALL C:\BENCH\RUNTEST DOOM
CALL C:\BENCH\RUNTEST QUAKE
IF EXIST %S%\UPLOAD.OK GOTO END

:UPLOAD
IF "%NETDRV%"=="" GOTO NONET
IF NOT EXIST %NETDRV%\RESULTS\NUL GOTO NONET
IF NOT EXIST %NETDRV%\RESULTS\%HOST%\NUL MD %NETDRV%\RESULTS\%HOST%
IF NOT EXIST %NETDRV%\RESULTS\%HOST%\NEW\NUL MD %NETDRV%\RESULTS\%HOST%\NEW
COPY %R%\*.* %NETDRV%\RESULTS\%HOST%\NEW > NUL
ECHO done> %NETDRV%\RESULTS\%HOST%\NEW\READY.TXT
ECHO done> %S%\UPLOAD.OK
ECHO BENCH: results on %NETDRV%\RESULTS\%HOST%\NEW
GOTO END
:NONET
ECHO BENCH: no network drive, results stay in %R% and go up on the next BENCH
GOTO END
:NOCFG
ECHO BENCH: C:\BENCH\HOST.BAT missing, copy HOST.SMP and fill it in
:END
CD \
